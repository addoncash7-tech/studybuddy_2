# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to GitHub.

# Get this from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Credentials for the built-in admin account (used to approve new users)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_something_strong

# Port the server listens on. AIC Cloud / most hosts inject this automatically -
# leave it unset in production and let the platform set PORT for you.
PORT=8000
